{
  "name": "@cogniplane/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:bundle": "esbuild src/server.ts src/scripts/migrate.ts src/scripts/delete-tenant.ts --bundle --packages=external --platform=node --format=esm --outdir=bundle --outbase=src --alias:@cogniplane-private/sharepoint-overlay-backend=../../private/sharepoint-overlay-backend/src/index.ts",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "db:seed-dev": "tsx src/scripts/seed-dev-data.ts",
    "tenant:delete": "tsx src/scripts/delete-tenant.ts",
    "dev": "tsx watch src/server.ts",
    "lint": "eslint src --ext .ts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@ag-ui/client": "1.0.3",
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/lib-storage": "^3.1156.0",
    "@cogniplane/shared-types": "workspace:*",
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "11.3.1",
    "@fastify/multipart": "10.1.6",
    "@langchain/anthropic": "1.6.0",
    "@langchain/core": "^1.3.0",
    "@langchain/google-genai": "2.3.4",
    "@langchain/langgraph": "^1.5.2",
    "@langchain/langgraph-checkpoint-postgres": "^1.1.2",
    "@langchain/mcp-adapters": "^2.0.1",
    "@langchain/openai": "1.7.0",
    "@workos-inc/node": "^12.0.0",
    "cron-parser": "^5.10.2",
    "deepagents": "1.15.1",
    "e2b": "2.59.0",
    "eventsource-parser": "4.1.2",
    "fastify": "5.12.7",
    "file-type": "^22.2.0",
    "ioredis": "^6.0.0",
    "jose": "6.2.13",
    "jszip": "^3.10.2",
    "langchain": "^1.5.19",
    "langsmith": "0.9.0",
    "pg": "8.23.1",
    "rxjs": "7.8.2",
    "tar": "^7.5.22",
    "undici": "^8.12.3",
    "yaml": "^2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@ag-ui/core": "1.0.3",
    "@types/pg": "8.23.1",
    "dpdm": "4.3.0",
    "esbuild": "0.28.2",
    "tsx": "4.23.15"
  }
}
