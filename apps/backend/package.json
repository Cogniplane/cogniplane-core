{
  "name": "@cogniplane/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:bundle": "esbuild src/server.ts src/scripts/migrate.ts --bundle --packages=external --platform=node --format=esm --outdir=bundle --outbase=src --alias:@cogniplane-private/sharepoint-overlay-backend=../../private/sharepoint-overlay-backend/src/index.ts",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "db:seed-dev": "tsx src/scripts/seed-dev-data.ts",
    "dev": "tsx watch src/server.ts",
    "lint": "eslint src --ext .ts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@ag-ui/client": "0.0.59",
    "@aws-sdk/client-s3": "^3.1135.0",
    "@aws-sdk/lib-storage": "^3.1135.0",
    "@cogniplane/shared-types": "workspace:*",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "11.3.0",
    "@fastify/multipart": "10.1.1",
    "@langchain/anthropic": "1.5.9",
    "@langchain/core": "^1.2.11",
    "@langchain/google-genai": "2.3.0",
    "@langchain/langgraph": "^1.4.15",
    "@langchain/langgraph-checkpoint-postgres": "^1.0.5",
    "@langchain/mcp-adapters": "^1.1.4",
    "@langchain/openai": "1.5.11",
    "@workos-inc/node": "^10.13.0",
    "cron-parser": "^5.10.1",
    "deepagents": "1.13.5",
    "e2b": "2.46.1",
    "fastify": "5.12.3",
    "file-type": "^22.1.1",
    "ioredis": "^6.0.0",
    "jose": "6.2.11",
    "jszip": "^3.10.2",
    "langchain": "^1.5.11",
    "langsmith": "0.9.0",
    "pg": "8.23.0",
    "rxjs": "7.8.1",
    "tar": "^7.5.22",
    "undici": "^7.29.1",
    "yaml": "^2.9.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "dpdm": "4.3.0",
    "esbuild": "0.28.2",
    "tsx": "4.23.13"
  }
}
