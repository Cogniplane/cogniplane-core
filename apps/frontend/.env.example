NEXT_PUBLIC_API_URL=http://localhost:3001

# Host MCP Apps on a separate origin. On that host, set MCP_APP_PARENT_ORIGIN
# to the exact Cogniplane origin so its sandbox response can be framed there.
NEXT_PUBLIC_MCP_APP_SANDBOX_ORIGIN=
MCP_APP_PARENT_ORIGIN=

# Set NEXT_PUBLIC_DEV_USER_ID for local dev (header-based auth).
# Remove or leave empty for production (WorkOS JWT auth).
NEXT_PUBLIC_DEV_USER_ID=local-dev-user
NEXT_PUBLIC_DEV_TENANT_ID=local-dev-tenant
