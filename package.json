{
  "name": "cogniplane-core",
  "private": true,
  "packageManager": "pnpm@10.34.9+sha512.f49b5a8ea0fdedb44bb3c0c1d6575092a53c2950d95b7ad15df11f17974877a2de3a01c07e934e9b28ce716e51c09a94962c7306d09be2e1e4b18a8c8762fd32",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "node scripts/check-dev-ports.mjs && pnpm --parallel --filter @cogniplane/backend --filter @cogniplane/frontend dev",
    "lint": "eslint .",
    "test": "pnpm test:all",
    "test:all": "node scripts/run-vitest.mjs run",
    "test:watch": "node scripts/run-vitest.mjs",
    "test:coverage": "pnpm --filter @cogniplane/backend exec node ../../scripts/run-vitest.mjs run --coverage",
    "test:coverage:imported": "COVERAGE_SCOPE=imported pnpm --filter @cogniplane/backend exec node ../../scripts/run-vitest.mjs run --coverage",
    "test:coverage:frontend": "pnpm --filter @cogniplane/frontend exec node ../../scripts/run-vitest.mjs run --coverage",
    "test:coverage:frontend:imported": "COVERAGE_SCOPE=imported pnpm --filter @cogniplane/frontend exec node ../../scripts/run-vitest.mjs run --coverage",
    "test:integration": "node scripts/require-integration-db.mjs && pnpm --filter @cogniplane/backend exec node ../../scripts/run-vitest.mjs run --config vitest.integration.config.ts && pnpm --filter @cogniplane-private/sharepoint-overlay-backend exec node ../../scripts/run-vitest.mjs run src/services/microsoft-connection-store.integration.test.ts src/routes/microsoft-tenant-routes.integration.test.ts",
    "test:coverage:integration": "node scripts/require-integration-db.mjs && pnpm --filter @cogniplane/backend exec node ../../scripts/run-vitest.mjs run --config vitest.integration.config.ts --coverage",
    "test:coverage:merged": "pnpm test:coverage:integration && tsx scripts/merge-coverage.ts",
    "test:e2e:local": "node scripts/e2e-local-stack.mjs",
    "test:frontend-worker": "node scripts/smoke-frontend-worker.mjs",
    "typecheck": "pnpm -r --workspace-concurrency=1 typecheck && pnpm typecheck:tests && pnpm typecheck:scripts",
    "typecheck:tests": "pnpm --filter @cogniplane/backend typecheck:test && pnpm --filter @cogniplane-private/sharepoint-overlay-backend typecheck:test",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json --noEmit",
    "db:migrate": "pnpm --filter @cogniplane/backend db:migrate",
    "license:check": "tsx scripts/license-check.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "^16.4.5",
    "@types/node": "26.6.6",
    "@types/spdx-expression-parse": "4.0.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "5.1.0",
    "dotenv": "^18.0.9",
    "e2b": "2.63.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "17.14.0",
    "husky": "^9.1.7",
    "jsdom": "30.1.3",
    "spdx-expression-parse": "5.0.0",
    "tsx": "4.23.15",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0",
    "yaml": "^2.9.1"
  },
  "pnpm": {
    "overrides": {
      "@babel/core@<=7.29.0": ">=7.29.6 <8",
      "@hono/node-server@<2.1.3": ">=2.1.3 <3",
