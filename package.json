      "vite@>=8.0.0 <8.3.5": "8.3.5",
      "zod": "4.6.7",
      "@ag-ui/client": "1.0.3",
      "@ag-ui/core": "1.0.3",
      "@ag-ui/proto": "1.0.3",
      "@ag-ui/encoder": "1.0.3",
      "rxjs": "7.8.2"
    },
    "patchedDependencies": {
      "@a2ui/web_core@0.10.4": "patches/@a2ui__web_core@0.10.4.patch",
      "@copilotkit/a2ui-renderer@1.79.1": "patches/@copilotkit__a2ui-renderer@1.79.1.patch"
    }
  }
}
