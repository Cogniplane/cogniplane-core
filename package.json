{
  "name": "cogniplane-core",
  "private": true,
  "packageManager": "pnpm@10.34.8+sha512.f627a8e971343afe49dfd0f63d028234201dfa831d5cb588733e1e5f8db26bf16989a32161ab5c1b4db3b1fdbc373160606b5b89e002df6dd19a85adf91fc5a8",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "node scripts/check-dev-ports.mjs && pnpm --parallel --filter @cogniplane/backend --filter @cogniplane/frontend dev",
    "lint": "eslint .",
    "test": "pnpm test:all",
    "test:all": "node scripts/run-vitest.mjs run",
    "test:watch": "node scripts/run-vitest.mjs",
    "test:coverage": "pnpm --filter @cogniplane/backend exec node ../../scripts/run-vitest.mjs run --coverage",
    "test:coverage:imported": "COVERAGE_SCOPE=imported pnpm --filter @cogniplane/backend exec node ../../scripts/run-vitest.mjs run --coverage",
    "test:coverage:frontend": "pnpm --filter @cogniplane/frontend exec node ../../scripts/run-vitest.mjs run --coverage",
    "test:coverage:frontend:imported": "COVERAGE_SCOPE=imported pnpm --filter @cogniplane/frontend exec node ../../scripts/run-vitest.mjs run --coverage",
    "test:integration": "node scripts/require-integration-db.mjs && pnpm --filter @cogniplane/backend exec node ../../scripts/run-vitest.mjs run --config vitest.integration.config.ts",
    "test:e2e:local": "node scripts/e2e-local-stack.mjs",
    "test:frontend-worker": "node scripts/smoke-frontend-worker.mjs",
    "typecheck": "pnpm -r --workspace-concurrency=1 typecheck && pnpm typecheck:tests && pnpm typecheck:scripts",
    "typecheck:tests": "pnpm --filter @cogniplane/backend typecheck:test",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json --noEmit",
    "db:migrate": "pnpm --filter @cogniplane/backend db:migrate",
    "license:check": "tsx scripts/license-check.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "^16.4.3",
    "@types/node": "26.6.5",
    "@types/spdx-expression-parse": "4.0.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "dotenv": "^18.0.9",
    "e2b": "2.59.0",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "17.13.0",
    "husky": "^9.1.7",
    "jsdom": "30.1.3",
    "spdx-expression-parse": "5.0.0",
    "tsx": "4.23.15",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5",
    "yaml": "^2.9.1"
  },
  "pnpm": {
    "overrides": {
      "@babel/core@<=7.29.0": ">=7.29.6 <8",
      "@hono/node-server@<2.0.5": ">=2.0.5",
      "@modelcontextprotocol/sdk@>=1.12.0 <1.31.0": ">=1.31.0 <2",
      "body-parser@>=2.0.0 <2.4.0": ">=2.4.0 <3",
      "brace-expansion@>=2.0.0 <2.1.4": ">=2.1.4 <3",
      "brace-expansion@>=4.0.0 <5.0.9": ">=5.0.9",
      "browserslist@>=4 <4.28.7": ">=4.28.7 <5",
      "dompurify@<3.4.17": ">=3.4.17 <4",
