      "openai@7.51.0>undici": "^7.30.1 || ^8.12.2",
      "postcss@<8.5.18": ">=8.5.18",
      "prismjs@<1.30.0": ">=1.30.0",
      "qs@>=6.7.0 <6.16.1": ">=6.16.1 <7",
      "sharp@<0.35.5": ">=0.35.5",
      "source-map-js@>=1.0.0 <1.2.2": ">=1.2.2 <2",
      "undici@>=6.0.0 <6.29.1": ">=6.29.1 <7",
      "undici@>=7.0.0 <7.30.1": ">=7.30.1 <8",
      "undici@>=8.0.0 <8.12.2": ">=8.12.2 <9",
      "undici8": "npm:undici@>=8.12.2 <9",
      "vite@>=8.0.0 <8.3.5": "8.3.5",
      "zod": "4.6.7",
      "@ag-ui/client": "1.0.3",
      "@ag-ui/core": "1.0.3",
      "@ag-ui/proto": "1.0.3",
      "@ag-ui/encoder": "1.0.3",
      "rxjs": "7.8.2"
