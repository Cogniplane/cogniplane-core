      "glob@>=10.2.0 <10.5.0": ">=10.5.0 <11",
      "hono@<4.13.11": ">=4.13.11 <5",
      "ip-address@<10.7.4": ">=10.7.4 <11",
      "katex@>=0.11.0 <0.18.2": ">=0.18.2 <0.19",
      "lodash-es@<4.18.1": ">=4.18.1",
      "mermaid@<11.16.1": ">=11.16.1",
      "nanoid@<3.3.17": ">=3.3.17",
      "openai@7.30.1>undici": "^7.30.1 || ^8.12.2",
      "postcss@<8.5.18": ">=8.5.18",
      "prismjs@<1.30.0": ">=1.30.0",
      "qs@>=6.11.1 <6.16.0": "6.16.0",
      "sharp@<0.35.5": ">=0.35.5",
      "source-map-js@>=1.0.0 <1.2.2": ">=1.2.2 <2",
      "undici@>=6.0.0 <6.29.1": ">=6.29.1 <7",
