      "brace-expansion@>=4.0.0 <5.0.9": ">=5.0.9",
      "browserslist@>=4 <4.28.7": ">=4.28.7 <5",
      "dompurify@<3.4.17": ">=3.4.17 <4",
      "fast-uri@>=3.0.0 <3.1.9": ">=3.1.9 <4",
      "fast-uri@>=4.0.0 <4.2.3": ">=4.2.3 <5",
      "form-data@<4.0.6": ">=4.0.6",
      "glob@>=9.0.0 <14.0.2": ">=14.0.2 <15",
      "hono@<4.13.11": ">=4.13.11 <5",
      "ip-address@<10.7.4": ">=10.7.4 <11",
      "katex@>=0.11.0 <0.18.2": ">=0.18.2 <0.19",
      "lodash-es@<4.18.1": ">=4.18.1",
      "mermaid@<11.16.1": ">=11.16.1",
