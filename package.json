{
  "name": "cogniplane-core",
  "private": true,
  "packageManager": "pnpm@10.32.1+sha512.a706938f0e89ac1456b6563eab4edf1d1faf3368d1191fc5c59790e96dc918e4456ab2e67d613de1043d2e8c81f87303e6b40d4ffeca9df15ef1ad567348f2be",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "pnpm -r build",
    "codex:release:check": "pnpm --filter @cogniplane/backend exec vitest run src/codex-release.test.ts",
    "codex:schema:generate": "node scripts/generate-codex-schemas.mjs",
    "dev": "node scripts/check-dev-ports.mjs && pnpm --parallel --filter @cogniplane/backend --filter @cogniplane/frontend dev",
    "lint": "eslint .",
    "test": "pnpm -r --if-present test",
    "test:all": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "pnpm --filter @cogniplane/backend exec vitest run --coverage",
    "test:e2e:local": "node scripts/e2e-local-stack.mjs",
    "typecheck": "pnpm -r typecheck",
    "db:migrate": "pnpm --filter @cogniplane/backend db:migrate",
    "license:check": "tsx scripts/license-check.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "^16.2.9",
    "@types/node": "26.0.1",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "4.1.9",
    "dotenv": "^17.4.2",
    "e2b": "2.31.0",
    "eslint": "10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "17.6.0",
    "husky": "^9.1.7",
    "ts-morph": "^28.0.0",
    "tsx": "4.22.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.62.1",
    "vitest": "4.1.9",
    "yaml": "^2.9.0"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@>=4.0.0 <5.0.6": ">=5.0.6",
      "fast-uri@<3.1.2": ">=3.1.2",
      "form-data@<4.0.6": ">=4.0.6",
      "hono@<4.12.25": "4.12.27",
      "ip-address@<=10.1.0": "10.1.1",
      "picomatch@4.0.3": "4.0.4",
      "postcss@<8.5.10": ">=8.5.10",
      "qs@>=6.11.1 <=6.15.1": "6.15.2",
      "undici@>=7.0.0 <7.28.0": "7.28.0",
      "vite@>=8.0.0 <=8.0.15": ">=8.0.16"
    }
  }
}
