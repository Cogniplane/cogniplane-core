diff --git a/dist/react-renderer/catalog-utils.cjs b/dist/react-renderer/catalog-utils.cjs
--- a/dist/react-renderer/catalog-utils.cjs
+++ b/dist/react-renderer/catalog-utils.cjs
@@ -4 +4,17 @@
-let zod_to_json_schema = require("zod-to-json-schema");
+const { z } = require('zod');
+function zodToJsonSchema(schema, options) {
+    const result = z.toJSONSchema(schema, {
+        target: 'draft-7',
+        io: 'input',
+        override: ({ zodSchema, jsonSchema }) => {
+            if (zodSchema.type === 'object' && !zodSchema.def.catchall) {
+                jsonSchema.additionalProperties = false;
+            }
+        },
+    });
+    if (options?.target === 'jsonSchema2019-09') {
+        result.$schema = 'https://json-schema.org/draft/2019-09/schema#';
+    }
+    return result;
+}
